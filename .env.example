# =============================================================================
# CA Helper environment variables
#
# `make setup` copies this file to .env and fills in random dev secrets.
# .env is gitignored. Never commit real secrets.
#
# BOTH run modes read the same .env:
#   Hybrid mode (daily dev, `make dev-backend`): Flask and the worker run on
#     your machine, so hostnames below are `localhost`.
#   Full-Docker mode (`make up`): docker-compose.yml overrides DATABASE_URL,
#     MAIL_SERVER and UPLOAD_DIR for the backend/worker containers with Docker
#     service names (`db`, `mailpit`). You do not edit anything to switch modes.
#
# Rule: every new variable is added here, with a comment, in the same PR.
# =============================================================================

# --- Application ------------------------------------------------------------
# Which config class to use: development | testing | production
APP_ENV=development
# Flask secret key (sessions, signing). `make setup` generates a random value.
SECRET_KEY=change-me
# Key used to sign JWT access/refresh tokens. `make setup` generates a random value.
JWT_SECRET_KEY=change-me
# Browser origins allowed to call the API (comma-separated). In both run modes the
# frontend proxies /api, so this matters only when the frontend is on another origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Public URL of the frontend, used to build links in emails.
# Hybrid: http://localhost:5173   Full-Docker: http://localhost:8080
FRONTEND_URL=http://localhost:5173

# --- Database (Postgres 16 + pgvector, the `db` service) ---------------------
# Credentials used by the db container when it is first created.
POSTGRES_USER=ca_helper
POSTGRES_PASSWORD=ca_helper_dev
POSTGRES_DB=ca_helper
# Host port the db container publishes. Change it (and the URLs below) if 5432 is taken.
DB_HOST_PORT=5432
# SQLAlchemy URL used by Flask and the worker.
# Hybrid:      ...@localhost:5432/ca_helper   (this value)
# Full-Docker: ...@db:5432/ca_helper          (set automatically by docker-compose.yml)
DATABASE_URL=postgresql+psycopg://ca_helper:ca_helper_dev@localhost:5432/ca_helper
# Separate database used only by pytest. The test fixtures create it if it is missing.
TEST_DATABASE_URL=postgresql+psycopg://ca_helper:ca_helper_dev@localhost:5432/ca_helper_test

# --- Email (Mailpit catches all mail in dev; web UI at http://localhost:8025) ---
# Hybrid: localhost   Full-Docker: mailpit (set automatically by docker-compose.yml)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="CA Helper <no-reply@ca-helper.local>"

# --- Encryption (used from Phase 1: EncryptedString, blind index, file storage) ---
# Fernet key for field-level and file encryption. `make setup` generates one. To make one by hand:
#   conda run -n ca-helper python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes existing encrypted data unreadable.
FIELD_ENCRYPTION_KEY=
# Secret for the HMAC-SHA256 "blind index" used to look up encrypted fields (PAN, GSTIN...).
# `make setup` generates one (64 hex characters).
BLIND_INDEX_KEY=
# Directory for encrypted uploaded files.
# Hybrid: relative to backend/ (backend/instance/uploads, gitignored)   Full-Docker: /data/uploads (volume)
UPLOAD_DIR=instance/uploads

# --- Gemini (Phase 1+). Every call goes through app/core/ai/gemini_client.py -------
# Your own key from https://aistudio.google.com/apikey. Each member uses their own.
GEMINI_API_KEY=
# Model names change often. Current list: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Rate limiting (Flask-Limiter) --------------------------------------------
# memory:// keeps counters per process. That is fine for development.
RATELIMIT_STORAGE_URI=memory://
