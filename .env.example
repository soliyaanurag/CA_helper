# Copy this file to .env and fill in the values (placeholders only here, never real secrets).
# CA Helper settings. docker compose reads .env. Never commit .env (it is gitignored).
# The whole team uses the same DATABASE_URL, SECRET_KEY, JWT_SECRET_KEY and FIELD_ENCRYPTION_KEY.

# --- Database ------------------------------------------------------------------
# Neon, direct connection (no "-pooler" in the host), scheme postgresql+psycopg://, ending in ?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Secrets -------------------------------------------------------------------
# Any long random text, e.g. from: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
# Encrypts PAN, GSTIN, TAN, phone and uploaded files. Changing it makes stored data unreadable. Make one with:
#   docker compose run --rm backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me

# --- Gemini (each member may use their own key; empty = keyword fallbacks) --------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Demo users (created by `flask seed`) ------------------------------------------
DEMO_BUSINESS_EMAIL=business@demo.local
DEMO_BUSINESS_PASSWORD=DemoBusiness#2026
DEMO_CA_EMAIL=ca@demo.local
DEMO_CA_PASSWORD=DemoCA#2026
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=DemoAdmin#2026
