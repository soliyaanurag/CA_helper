# =============================================================================
# CA Helper environment variables
#
# Copy this file to .env (docker compose reads it) and fill in the secrets.
# .env is gitignored. Never commit real secrets. The team shares one .env privately:
# the three secrets below must be the same on every laptop.
#
# Rule: every new variable is added here, with a comment, in the same PR.
# =============================================================================

# --- Application ------------------------------------------------------------
# Config class for the dev server, worker and flask commands (pytest always uses "testing").
APP_ENV=development
# Flask secret key (signing). Any long random text, e.g. from:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Key used to sign JWT access tokens. Any long random text (same command as above).
JWT_SECRET_KEY=change-me
# Fernet key that encrypts PAN, GSTIN, TAN and phone in the database. Make one with:
#   docker compose run --rm backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes the encrypted values already stored unreadable.
FIELD_ENCRYPTION_KEY=change-me
# Where uploaded files (e.g. CA certificates) are stored, encrypted with FIELD_ENCRYPTION_KEY.
# Relative to backend/ (backend/instance/ is gitignored) or an absolute path.
UPLOAD_DIR=instance/uploads
# The largest file anyone may upload, in megabytes.
MAX_UPLOAD_MB=5
# Lifetime of a login (JWT access token) in minutes. There is no refresh token yet,
# so after this the user logs in again.
JWT_ACCESS_TOKEN_MINUTES=60
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database (Postgres 16 + pgvector) -----------------------------------------
# SQLAlchemy URL used by Flask and the worker. For now the `db` container of docker-compose.yml.
DATABASE_URL=postgresql+psycopg://ca_helper:ca_helper_dev@db:5432/ca_helper
# pytest uses its own database in the `db` container; docker-compose.yml sets TEST_DATABASE_URL.

# --- Gemini (app/utils/gemini_client.py) --------------------------------------------
# Free API key from Google AI Studio (https://aistudio.google.com/apikey). Keep it only
# in your .env. Empty = AI features fall back (e.g. NIC suggestions use keyword matches).
GEMINI_API_KEY=
# Which Gemini model to call. gemini-flash-latest always points to the current Flash model;
# any other model name from Google AI Studio works (old ones are retired over time).
GEMINI_MODEL=gemini-flash-latest
# Model that turns texts into vectors (768 numbers) for the AI assistant's search (kb_chunks).
GEMINI_EMBED_MODEL=gemini-embedding-001
# Give up on a Gemini call after this many seconds (the feature then falls back).
GEMINI_TIMEOUT_SECONDS=20

# --- Email (app/utils/email.py) ---------------------------------------------------
# Signup codes, password reset codes and notices go to Mailpit (docker-compose.yml sets
# MAIL_SERVER and MAIL_PORT): it catches every email; read them at http://localhost:8025.
# The From address of every email.
MAIL_DEFAULT_SENDER="CA Helper <no-reply@ca-helper.local>"

# --- Demo users (development only) --------------------------------------------
# `flask seed` creates one user per role from these values (passwords are stored as
# argon2 hashes). Leave a pair empty to skip that user. Re-running the seed never
# changes an existing user: to change a demo password, reset your dev database.
# Never use these accounts or passwords anywhere real.
DEMO_BUSINESS_EMAIL=business@demo.local
DEMO_BUSINESS_PASSWORD=DemoBusiness#2026
DEMO_CA_EMAIL=ca@demo.local
DEMO_CA_PASSWORD=DemoCA#2026
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=DemoAdmin#2026
