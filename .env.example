# =============================================================================
# CA Helper environment variables
#
# `make setup` copies this file to .env and fills in random dev secrets.
# .env is gitignored. Never commit real secrets.
# Read by Flask, the worker, pytest and Docker Compose (db credentials).
#
# Rule: every new variable is added here, with a comment, in the same PR.
# =============================================================================

# --- Application ------------------------------------------------------------
# Which config class to use: development | testing
APP_ENV=development
# Flask secret key (sessions, signing). `make setup` generates a random value.
SECRET_KEY=change-me
# Key used to sign JWT access tokens. `make setup` generates a random value.
JWT_SECRET_KEY=change-me
# Lifetime of a login (JWT access token) in minutes. There is no refresh token yet,
# so after this the user logs in again.
JWT_ACCESS_TOKEN_MINUTES=60
# Browser origins allowed to call the API (comma-separated). The Vite dev server
# proxies /api, so this matters only when the frontend is on another origin.
CORS_ORIGINS=http://localhost:5173
# Console log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database (Postgres 16, the `db` service in docker-compose.yml) ---------
# Credentials used by the db container when it is first created.
POSTGRES_USER=ca_helper
POSTGRES_PASSWORD=ca_helper_dev
POSTGRES_DB=ca_helper
# Host port the db container publishes. Change it (and the URLs below) if 5432 is taken.
DB_HOST_PORT=5432
# SQLAlchemy URL used by Flask and the worker.
DATABASE_URL=postgresql+psycopg://ca_helper:ca_helper_dev@localhost:5432/ca_helper
# Separate database used only by pytest. The test fixtures create it if it is missing.
TEST_DATABASE_URL=postgresql+psycopg://ca_helper:ca_helper_dev@localhost:5432/ca_helper_test

# --- Rate limiting (Flask-Limiter) --------------------------------------------
# memory:// keeps counters per process. That is fine for development.
RATELIMIT_STORAGE_URI=memory://

# --- Demo users (development only) --------------------------------------------
# `make seed` creates one user per role from these values (passwords are stored as
# argon2 hashes). Leave a pair empty to skip that user. Re-running the seed never
# changes an existing user: to change a demo password, reset your dev database.
# Never use these accounts or passwords anywhere real.
DEMO_BUSINESS_EMAIL=business@demo.local
DEMO_BUSINESS_PASSWORD=DemoBusiness#2026
DEMO_CA_EMAIL=ca@demo.local
DEMO_CA_PASSWORD=DemoCA#2026
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=DemoAdmin#2026
